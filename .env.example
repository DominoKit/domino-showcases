# Remote deploy target
DEPLOY_HOST=example.com
DEPLOY_USER=deploy

# Optional SSH settings
DEPLOY_SSH_PORT=22
# DEPLOY_SSH_KEY_FILE=/home/user/.ssh/id_ed25519

# Optional remote paths
DEPLOY_REMOTE_BASE_DIR=/opt/domino-showcases
DEPLOY_REMOTE_DIST_DIR=/opt/domino-showcases/.dist
DEPLOY_REMOTE_COMPOSE_FILE=/opt/domino-showcases/docker-compose.yml

# Optional local file to bundle into the domino-site image as /tmp/github-app.pem.
# This is useful when the remote compose uses GITHUB_APP_PRIVATE_KEY_FILE=/tmp/github-app.pem.
# SITE_GITHUB_APP_PEM_FILE=/path/to/github-app.pem

# Optional toggle to reuse an existing local .dist/ instead of rebuilding it.
# DEPLOY_SKIP_BUILD=true

# Optional toggle to copy and rebuild images remotely without restarting compose services.
# DEPLOY_RESTART_SERVICES=false
